// This is a test/mock-up example
// This code may not compile.

@extern "c" printf;

func main() i32 {
    let u8 n = 10;
    let u64 t1 = 0;
    let u64 t2 = 1;
    let u64 nextTerm;

    printf("Fibonacci Series up to %d terms:\n", n);

    let u8 @"सूचकांक चर" = 1;
    while ( @"सूचकांक चर" <= n) {
        printf("%llu ", t1);
        nextTerm = t1 + t2;
        t1 = t2;
        t2 = nextTerm;
        ++@"सूचकांक चर";
    }
    printf("\n");
    // comment
    return 0;
}
