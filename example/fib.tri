// This is a test/mock-up example
// This code may not compile.

@extern "c" printf;

func main() -> i32 {
    n : u8 = 10;
    t1 : u64 = 0;
    t2 : u64 = 1;
    nextTerm : u64;

    printf("Fibonacci Series up to %d terms:\n", n);

    @"सूचकांक चर" : u8 = 1;
    while ( @"सूचकांक चर" <= n) {
        printf("%llu ", t1);
        nextTerm = t1 + t2;
        t1 = t2;
        t2 = nextTerm;
        @"सूचकांक चर" += 1;
    }
    printf("\n");
    // comment
    return 0;
}
