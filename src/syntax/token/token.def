LITERAL(IDENTIFIER)
LITERAL(INT)
LITERAL(FLOAT)
LITERAL(STRING)
LITERAL(CHARACTER)

KEYWORD(VOID, "void")
KEYWORD(I8, "i8")
KEYWORD(I16, "i16")
KEYWORD(I32, "i32")
KEYWORD(I64, "i64")
KEYWORD(I128, "i128")
KEYWORD(ISIZE, "isize")
KEYWORD(U8, "u8")
KEYWORD(U16, "u16")
KEYWORD(U32, "u32")
KEYWORD(U64, "u64")
KEYWORD(U128, "u128")
KEYWORD(USIZE, "usize")
KEYWORD(BOOL, "bool")
KEYWORD(F16, "f16")
KEYWORD(F32, "f32")
KEYWORD(F64, "f64")
KEYWORD(F128, "f128")
KEYWORD(STR, "str")
KEYWORD(TRUE, "true")
KEYWORD(FALSE, "false")
KEYWORD(ENUM, "enum")
KEYWORD(UNION, "union")
KEYWORD(STRUCT, "struct")
KEYWORD(ALIAS, "alias")
KEYWORD(PUB, "pub")
KEYWORD(VOLATILE, "volatile")
KEYWORD(CONST, "const")
KEYWORD(MUT, "mut")
KEYWORD(FUNC, "func")
KEYWORD(RETURN, "return")
KEYWORD(IF, "if")
KEYWORD(ELSE, "else")
KEYWORD(LOOP, "loop")
KEYWORD(WHILE, "while")
KEYWORD(MATCH, "match")
KEYWORD(CASE, "case")
KEYWORD(BREAK, "break")
KEYWORD(CONTINUE, "continue")

INTRINSIC(HERE, "@here")
INTRINSIC(MODULE, "@module")
INTRINSIC(IMPORT, "@import")
INTRINSIC(EXTERN, "@extern")
INTRINSIC(SIZEOF, "@sizeof")
INTRINSIC(TYPEOF, "@typeof")
INTRINSIC(ALIGNOF, "@alignof")
INTRINSIC(DEFINE, "@define")
INTRINSIC(UNDEFINE, "@undefine")
INTRINSIC(MACRO, "@macro")
INTRINSIC(ATTRIBUTE, "@attribute")
INTRINSIC(NORETURN, "@noreturn")
INTRINSIC(CALLCONV, "@callconv")
INTRINSIC(INLINE, "@inline")

PUNCTUATION(BITSHIFT_L, "<<")
PUNCTUATION(LESSER_EQUAL, "<=")
PUNCTUATION(BITSHIFT_R, ">>")
PUNCTUATION(GREATER_EQUAL, ">=")
PUNCTUATION(INC, "++")
PUNCTUATION(DEC, "--")
PUNCTUATION(NOT_EQUAL, "!=")
PUNCTUATION(EQUAL, "==")
PUNCTUATION(O_BRACE, "{")
PUNCTUATION(C_BRACE, "}")
PUNCTUATION(O_BRACKET, "[")
PUNCTUATION(C_BRACKET, "]")
PUNCTUATION(O_PREN, "(")
PUNCTUATION(C_PREN, ")")
PUNCTUATION(SEMICOLON, ";")
PUNCTUATION(COLON, ":")
PUNCTUATION(Q_MARK, "?")
PUNCTUATION(BIT_AND, "&")
PUNCTUATION(BIT_OR, "|")
PUNCTUATION(COMMA, ",")
PUNCTUATION(MUL, "*")
PUNCTUATION(DEV, "/")
PUNCTUATION(MOD, "%")
PUNCTUATION(ADD, "+")
PUNCTUATION(SUB, "-")
PUNCTUATION(NOT, "!")
PUNCTUATION(ASSIGN, "=")
PUNCTUATION(LESSER, "<")
PUNCTUATION(GREATER, ">")

TOKEN(UNKNOWN_TOKEN, "UNKNOWN")
TOKEN(COMMENT, "//")
TOKEN(WHITE_SPACE, "WS")
TOKEN(NEW_LINE, "NL")
TOKEN(END_OF_TOKEN, "EOT")
